\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Aggregate versus factorial decomposition of Target-Country effects on CETSCALE ethnocentrism, computed with identical OT-coupled estimators. The aggregate benchmark (collapsing over \textsc  {Model}) reports a single Target-Country main effect that is, by construction, uniform across models. The factorial \textsc  {Model}\,$\times $\,\textsc  {Target} interaction isolates the country-of-origin bias that aggregation cannot represent. Bold interactions indicate a sign reversal relative to the aggregate main effect (i.e., conditions for which the aggregate view is directionally incorrect).}}{28}{table.caption.36}\protected@file@percent }
\newlabel{tab:aggregate-vs-factorial}{{9}{28}{Aggregate versus factorial decomposition of Target-Country effects on CETSCALE ethnocentrism, computed with identical OT-coupled estimators. The aggregate benchmark (collapsing over \textsc {Model}) reports a single Target-Country main effect that is, by construction, uniform across models. The factorial \textsc {Model}\,$\times $\,\textsc {Target} interaction isolates the country-of-origin bias that aggregation cannot represent. Bold interactions indicate a sign reversal relative to the aggregate main effect (i.e., conditions for which the aggregate view is directionally incorrect)}{table.caption.36}{}}
\newlabel{tab:aggregate-vs-factorial@cref}{{[table][9][]9}{[1][24][]28}{}{}{}}
